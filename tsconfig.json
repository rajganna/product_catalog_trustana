{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2019",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strictNullChecks": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strictBindCallApply": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "migrations",
    "ormconfig.js",
    "dist"
  ]
}
