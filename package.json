{
  "name": "product-service",
  "version": "0.1.1",
  "description": "Product service for attribute setup",
  "author": "Raj Gannamaneni",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\"",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "spell": "cspell \"src/**/*.ts\" \"*.md\"",
    "spell:fix": "cspell \"src/**/*.ts\" \"*.md\" --no-progress",
    "start": "ts-node src/main.ts",
    "start:dev": "nodemon",
    "start:worker:dev": "nodemon --config nodemon.worker.json",
    "start:debug": "nodemon --config nodemon-debug.json",
    "start:worker:debug": "nodemon --config nodemon.worker-debug.json",
    "start:prod": "node --max-old-space-size=900 src/main.js",
    "start:worker:prod": "node --max-old-space-size=900 src/worker/main.js",
    "start:migrator": "node CI/migrations/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect=9229 -r ts-node/register node_modules/.bin/jest --runInBand --watch",
    "validate:swagger": "swagger-cli validate docs/swagger/oas3.yaml",
    "quality": "npm run lint && npm run format:check && npm run spell && npm run test",
    "quality:fix": "npm run lint:fix && npm run format && npm run spell:fix",
    "prepush": "npm run quality && npm run validate:swagger && make lint-oas",
    "commit": "git-cz",
    "db:create-migration": "npm run typeorm -- migration:generate -d ./ormconfig.js",
    "db:migrate": "npm run typeorm -- migration:run -d ./ormconfig.js",
    "db:migrate:undo": "npm run typeorm -- migration:revert -d ./ormconfig.js",
    "db:migrate:data": "ts-node data-migrations",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "npm run prepush"
    }
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^8.1.1",
    "@nestjs/typeorm": "^10.0.0",
    "@types/bluebird": "^3.5.27",
    "@types/lodash": "^4.14.164",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "aws-sdk": "^2.848.0",
    "bluebird": "^3.5.5",
    "cache-manager": "^2.11.1",
    "cache-manager-redis-store": "^1.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cls-hooked": "^4.2.2",
    "dompurify": "^2.2.6",
    "express": "^4.18.0",
    "handlebars": "^4.7.7",
    "jsdom": "^15.2.1",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.27",
    "nestjs-config": "^1.4.4",
    "newrelic": "^7.2.1",
    "p-retry": "^4.2.0",
    "pg": "^8.5.1",
    "pg-promise": "^10.8.7",
    "redis": "^5.6.0",
    "reflect-metadata": "^0.1.13",
    "request-context": "^2.0.0",
    "rimraf": "^2.6.2",
    "rxjs": "^7.8.0",
    "sqs-consumer": "^5.4.0",
    "superagent": "^5.2.2",
    "swagger-ui-express": "^5.0.1",
    "tar": "6.0.1",
    "ts-node": "^10.9.0",
    "type-fest": "^0.5.2",
    "typeorm": "^0.3.17",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
    "winston": "^3.8.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/testing": "^10.0.0",
    "@types/cache-manager": "^2.10.0",
    "@types/dompurify": "^2.2.1",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/jsdom": "^12.2.4",
    "@types/newrelic": "^5.11.0",
    "@types/supertest": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "commitizen": "^4.3.1",
    "cspell": "^9.1.3",
    "cz-conventional-changelog": "^3.3.0",
    "docker-compose": "^0.23.6",
    "dotenv": "^16.0.0",
    "escape-string-regexp": "^2.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "husky": "^8.0.0",
    "is-ci": "^2.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^8.2.1",
    "nock": "^13.0.7",
    "nodemon": "^2.0.4",
    "npm": "^7.5.2",
    "prettier": "^3.6.2",
    "rosie": "^2.0.1",
    "superagent-defaults": "^0.1.14",
    "supertest": "^6.3.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.4.0",
    "tslint": "5.11.0",
    "tslint-config-prettier": "^1.18.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "cspell --no-progress"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "cspell --no-progress"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  }
}
